.env
# Runtime-mutated live config — the dashboard writes secrets (e.g. anthropic_api_key)
# into it. Ship config/display.json.example as the template instead.
config/display.json
client-app
# The compiled server. The image builds its own (Dockerfile -> /app/server); a
# committed one is 31MB of unstripped binary that nothing reads.
/server
__pycache__/
*.py
*.md
*.claude
.codex

# The firmware-client audit is a working report, not a product asset — kept out of the
# repo and served from the running container only.
static/firmware-client-audit.html

# Keys never go in git (a private key was committed here once, 11 Oct 2026)
tools/enroll-console/keys/
*.pem
id_rsa
id_ed25519
