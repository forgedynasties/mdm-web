# The client repos, checked out inside the server repo so the whole MDM is one
# clone. The server itself is this repo's root — it is both the superproject and
# the thing that deploys.
#
# Paths keep the folder names this tree has always used.
#
# `branch` is what `git submodule update --remote` follows. Not all are main —
# the DPC agent lives on menu-board.
#
# MDM Lite (aio-mdm-lite) was dropped on 2026-10-08: it left the client lineup on
# 2026-10-05 and nothing here targets it any more. The AIO Enroll Android app took
# its slot — the phone counterpart of the desktop Enroll app, enrolling over adb.
#
# URLs are https under ali-aio, the same account that owns AIOApp/mdm's default
# github.com key — so a recursive clone needs no ssh Host alias and the submodule
# entries render as real links on the web UI. The repos are public; the earlier
# git@forgedynasties:... form used an alias that only exists on our machines, which
# GitHub could not resolve into a repository.
#
# forgedynasties still holds a copy of each and stays current: every local checkout
# pushes to ali-aio AND forgedynasties. `git submodule sync` overwrites a checkout's
# remote with the single URL above — re-add the forge push URL if you ever run it.

[submodule "aio-mdm-client"]
	path = aio-mdm-client
	url = https://github.com/ali-aio/mdm-client-firmware.git
	branch = main

[submodule "aio-mdm-client-dpc"]
	path = aio-mdm-client-dpc
	url = https://github.com/ali-aio/mdm-client-dpc.git
	branch = menu-board

[submodule "aio-mdm-enroll-app"]
	path = aio-mdm-enroll-app
	url = https://github.com/ali-aio/mdm-enroll-app.git
	branch = main
[submodule "aio-mdm-enroll-android"]
	path = aio-mdm-enroll-android
	url = https://github.com/ali-aio/mdm-enroll-android.git
	branch = main
