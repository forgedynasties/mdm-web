# Server
PORT=8080

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=mdm
DB_PASSWORD=changeme
DB_NAME=mdm

# Shared key — every AOSP device must send this in X-API-Key header
DEVICE_API_KEY=change-this-to-a-long-random-string
ADMIN_API_KEY=
# Dashboard login
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme

# Session cookie signing secret. REQUIRED, >=32 bytes, and must be distinct from
# DEVICE_API_KEY / ADMIN_API_KEY. Generate one with e.g. `openssl rand -hex 32`.
SESSION_SECRET=another-long-random-string-change-me

# Trusted browser-facing origin(s) (scheme://host) for CSRF same-origin checks on
# dashboard POSTs. Comma-separate multiple domains that serve this dashboard. When
# unset, the check falls back to the request's Host header, which works behind a
# TLS-terminating proxy. Set it explicitly in production.
# PUBLIC_ORIGIN=https://udm.dev.aioapp.com,https://mdm.dev.aioapp.com

# The session cookie is marked Secure by default (only sent over HTTPS). Set to
# false for local HTTP development so login works without TLS.
# COOKIE_SECURE=false

# Transactional email (Amazon SES, SMTP interface) for self-service sign-up
# verification and password reset. Leave SES_SMTP_USERNAME/PASSWORD blank to
# disable sending — those flows still work, the email is just logged instead
# of delivered (useful for local dev).
#
# SES_SMTP_USERNAME/SES_SMTP_PASSWORD are SES-specific SMTP credentials, NOT
# your AWS access key/secret — generate them in the SES console under
# "SMTP settings" (or via `aws ses` / IAM, see AWS docs on converting an IAM
# secret key to an SMTP password). SES_SMTP_HOST defaults to
# "email-smtp.<AWS_REGION>.amazonaws.com" (reusing the same AWS_REGION the S3
# APK store below uses) if left blank — set it explicitly only if that default
# is wrong. SES_SMTP_PORT defaults to 587 (STARTTLS). MAIL_FROM_EMAIL must be a
# verified SES identity/domain or SES will reject the send; defaults to
# "AIO MDM <noreply@aioapp.com>" if unset.
SES_SMTP_HOST=
SES_SMTP_PORT=
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
MAIL_FROM_EMAIL=

# WiFi-based device geolocation (Google Geolocation API). Devices with no GPS
# send their WiFi neighbourhood (wifi_scan) on checkin; the server resolves it to
# lat/lon via Google. Set the key to enable; leave blank to disable. Requires the
# "Geolocation API" enabled on the GCP project + billing (no free tier).
GOOGLE_GEOLOCATION_API_KEY=

# Reverse geocoding (Google Geocoding API). Turns the resolved lat/lon into a
# street address (location_address) shown on the device page instead of raw
# coordinates. Server-side only — restrict this key to the server egress IP +
# "Geocoding API". Leave blank to keep showing coordinates.
GOOGLE_GEOCODING_API_KEY=

# Device-page location map (Google Maps Embed API). This key ships to the
# BROWSER in the iframe URL, so restrict it by HTTP referrer to the dashboard
# domain (e.g. https://mdm-stage.dev.aioapp.com/*) + "Maps Embed API" only.
# Leave blank to hide the map (coordinates/address still show as text).
GOOGLE_MAPS_EMBED_API_KEY=

# Persisted settings/config file. In Docker this should live on the data volume
# so all dashboard settings survive restarts (docker-compose sets this for you).
# CONFIG_PATH=/app/data/config.json

# AI analysis (optional). Setting AI_API_KEY here is equivalent to entering it in
# Settings → AI Analysis, but survives restarts and keeps the key out of the UI.
# Env values override the stored/UI settings on every restart.
#   AI_PROVIDER: anthropic | deepseek | openai
#   AI_BASE_URL: endpoint override (DeepSeek via Claude format: https://api.deepseek.com/anthropic)
#   AI_MODEL:    model id (e.g. deepseek-chat, claude-opus-4-8)
# Example — DeepSeek through its Anthropic-compatible endpoint:
# AI_PROVIDER=anthropic
# AI_BASE_URL=https://api.deepseek.com/anthropic
# AI_API_KEY=sk-your-deepseek-key
# AI_MODEL=deepseek-chat
# AI_DIGEST=false
